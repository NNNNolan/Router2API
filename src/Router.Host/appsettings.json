{
  "Database": {
    "Path": "data/router2api.db"
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "InstanceName": "router2api:"
  },
  "Auth": {
    "Admin": {
      "Enabled": true,
      "SessionLifetimeHours": 12,
      "Users": [
        {
          "Username": "admin",
          "Password": "",
          "DisplayName": "Administrator",
          "Roles": ["admin"]
        }
      ]
    },
    "ApiKey": {
      "Enabled": true,
      "Key": ""
    }
  },
  "Logging": {
    "DataRetentionDays": 30,
    "CleanupCron": "0 0 3 * * *",
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Router": "Information"
    }
  },
  "AllowedHosts": "*"
}
